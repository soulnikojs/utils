{
	"name": "@souljs/utils",
	"version": "0.0.3",
	"description": "A collection of useful utility functions for JavaScript and TypeScript projects of SoulnikoJs.",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepare": "husky",
		"format": "prettier --write src/",
		"publish-pkg": "npm publish --access public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soulnikojs/utils.git"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/soulnikojs/utils/issues"
	},
	"homepage": "https://github.com/soulnikojs/utils#readme",
	"author": {
		"name": "Soulniko",
		"email": "shweblee@gmail.com",
		"url": "https://github.com/soulnikojs"
	},
	"lint-staged": {
		"*.{ts,tsx,json,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "3.8.3",
		"tsdown": "^0.21.10"
	}
}
